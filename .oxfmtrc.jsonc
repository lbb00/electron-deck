{
  "$schema": "./node_modules/oxfmt/configuration_schema.json",
  "useTabs": true,
  "singleQuote": true,
  "semi": false,
  "trailingComma": "all",
  "sortPackageJson": false,
  "ignorePatterns": [
    ".claude/**",
    "examples/**",
    "dist/**",
    "scripts/**",
    "bench/**",
    "coverage/**"
  ],
  "overrides": [
    {
      "files": ["**/*.json", "**/*.jsonc", "**/*.json5"],
      "options": { "useTabs": false, "tabWidth": 2, "trailingComma": "none" }
    }
  ]
}
